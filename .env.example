# Copy to .env and fill in. Only needed for the cloud judges; the local
# Ollama judge needs nothing here.

# Groq free tier: https://console.groq.com/keys  (default headline judge)
GROQ_API_KEY=

# Google Gemini free tier: https://aistudio.google.com/app/apikey  (alternate cloud judge)
GEMINI_API_KEY=
